layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }
    tab name="terminal" {
        pane
    }
    tab name="claude code" focus=true {
        pane command="zsh" {
            args "-c" "source ~/dotfiles/zellij/scripts/claude-launcher.sh; exec zsh"
        }
    }
    tab name="docker" {
        pane command="zsh" {
            args "-c" "docker compose up; exec zsh"
        }
    }
}

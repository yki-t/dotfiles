{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "deny": [
      "AskUserQuestion"
    ],
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "date '+[%Y-%m-%d (%a) %H:%M:%S %Z]' | jq -Rc '{hookSpecificOutput:{hookEventName:\"UserPromptSubmit\",additionalContext:.}}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/cc-rein hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/cc-rein hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/cc-rein hook"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/cc-rein hook"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/cc-rein hook"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/cc-rein hook"
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "language": "敬体",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "verbose": false,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": false,
  "terminalProgressBarEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "feedbackDrafts": "off"
}
